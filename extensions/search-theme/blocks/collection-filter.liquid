{%- comment -%}
  App block "Collection filters" (mục 7.2). Grid native của collection in bằng Liquid trước (SEO + fallback, D11).
{%- endcomment -%}
<div
  class="sa-block sa-pending"
  data-searchapp-mount="search-page"
  data-mode="collection"
  data-collection="{{ collection.handle | escape }}"
  data-per-page="{{ block.settings.per_page | escape }}"
  data-columns="{{ block.settings.columns | escape }}"
  data-filter-position="{{ block.settings.filter_position | escape }}"
  data-show-sort="{{ block.settings.show_sort | escape }}"
  data-default-sort="{{ block.settings.default_sort | escape }}"
  {{ block.shopify_attributes }}
>
  {%- comment -%} Khung layout in sẵn (toolbar + cột filter giữ chỗ) → widget điền vào, grid native không bị di chuyển (CLS/LCP, task 2.14). {%- endcomment -%}
  <div class="sa-layout sa-layout--{{ block.settings.filter_position | escape }}">
    <div class="sa-toolbar"><p class="sa-total">{{ 'searchapp.results' | t: count: collection.products_count }}</p>{%- if block.settings.filter_position == 'drawer' -%}<span class="sa-skel sa-skel--pill"></span>{%- endif -%}{%- if block.settings.show_sort -%}<span class="sa-skel sa-skel--pill"></span>{%- endif -%}</div>
    {%- if block.settings.filter_position == 'left' or block.settings.filter_position == 'top' -%}<aside class="sa-filters" aria-hidden="true">{% render 'sa-skeleton', part: 'facets' %}</aside>{%- endif -%}
    <div class="sa-main">
      {% render 'sa-skeleton', part: 'grid', columns: block.settings.columns, per_page: block.settings.per_page %}
  {%- paginate collection.products by block.settings.per_page -%}
    <ul class="sa-grid" style="--sa-cols: {{ block.settings.columns | escape }}" data-native-results>
      {%- for product in collection.products -%}
        {% render 'sa-native-card', product: product %}
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}
      <nav class="sa-pagination" aria-label="{{ 'searchapp.pagination' | t }}">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  {%- endpaginate -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection filters",
  "target": "content",
  "stylesheet": "searchapp.css",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 12, "max": 48, "step": 4, "default": 24 },
    {
      "type": "select",
      "id": "filter_position",
      "label": "Filter position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "top", "label": "Top" },
        { "value": "drawer", "label": "Drawer" },
        { "value": "none", "label": "None (theme provides filters)" }
      ],
      "default": "left"
    },
    { "type": "checkbox", "id": "show_sort", "label": "Show sort dropdown", "default": true },
    {
      "type": "select",
      "id": "default_sort",
      "label": "Default sort",
      "info": "Leave on 'App setting' to use the collection's sort order (or the override set in the app).",
      "options": [
        { "value": "", "label": "App setting" },
        { "value": "manual", "label": "Featured" },
        { "value": "best_selling", "label": "Best selling" },
        { "value": "price_asc", "label": "Price, low to high" },
        { "value": "price_desc", "label": "Price, high to low" },
        { "value": "created_desc", "label": "Newest" }
      ],
      "default": ""
    }
  ]
}
{% endschema %}
