{%- comment -%}
  App embed (mục 7.1). Ngân sách hiệu năng (task 2.14): trang không phải search/collection KHÔNG tải gì lúc đầu —
  SDK + instant search nạp khi khách focus ô search; widget kết quả nạp khi có [data-searchapp-mount].
  window.SearchApp là stub { ready() } cho tới khi SDK thật tải (hợp đồng SDK v1 không đổi).
{%- endcomment -%}
{%- liquid
  assign sa_css = 'searchapp.css' | asset_url
  assign eager = block.settings.eager_sdk
  if request.page_type == 'search' or request.page_type == 'collection'
    assign eager = true
  endif
-%}
{% render 'sa-config',
  api_mode: block.settings.api_mode,
  proxy_path: block.settings.proxy_path,
  storefront_endpoint: block.settings.storefront_endpoint,
  css_url: sa_css
%}
{%- if eager -%}
  <script src="{{ 'searchapp-sdk.js' | asset_url }}" defer></script>
{%- endif -%}
<script>
  (function () {
    var sdk = {{ 'searchapp-sdk.js' | asset_url | json }};
    var results = {{ 'searchapp-results.js' | asset_url | json }};
    var instantSrc = {{ 'searchapp-instant.js' | asset_url | json }};
    var instant = {{ block.settings.instant | json }};
    var selector = {{ block.settings.input_selector | default: '' | json }} || 'form[action*="/search"] input[name="q"]';
    function load(src) {
      if (document.querySelector('script[src="' + src + '"]')) return;
      var s = document.createElement('script');
      s.src = src;
      s.async = true;
      document.head.appendChild(s);
    }
    window.SearchApp = window.SearchApp || {
      ready: function () {
        return new Promise(function (resolve) {
          document.addEventListener('searchapp:ready', function (e) { resolve(e.detail); }, { once: true });
          load(sdk);
        });
      }
    };
    if (instant) {
      document.addEventListener('focusin', function onFocus(e) {
        var t = e.target;
        if (t && t.matches && t.matches(selector)) {
          t.setAttribute('data-searchapp-instant', '');
          document.removeEventListener('focusin', onFocus, true);
          load(sdk);
          load(instantSrc);
        }
      }, true);
    }
    document.addEventListener('DOMContentLoaded', function () {
      if (document.querySelector('[data-searchapp-mount]')) {
        load(sdk);
        load(results);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Search & Filter",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "instant",
      "label": "Instant search dropdown",
      "default": true
    },
    {
      "type": "text",
      "id": "input_selector",
      "label": "Search input selector",
      "info": "Leave blank to attach to the theme's search form."
    },
    {
      "type": "select",
      "id": "api_mode",
      "label": "Connection",
      "options": [
        { "value": "proxy", "label": "Store domain (app proxy)" },
        { "value": "direct", "label": "Search API (CDN)" }
      ],
      "default": "proxy"
    },
    {
      "type": "text",
      "id": "proxy_path",
      "label": "App proxy path",
      "default": "/apps/search"
    },
    {
      "type": "text",
      "id": "storefront_endpoint",
      "label": "Storefront API endpoint (advanced)",
      "info": "Leave blank to use your myshopify.com domain."
    },
    {
      "type": "checkbox",
      "id": "eager_sdk",
      "label": "Load the developer SDK on every page",
      "info": "Only needed if a custom script calls window.SearchApp without data-searchapp-mount.",
      "default": false
    }
  ]
}
{% endschema %}
