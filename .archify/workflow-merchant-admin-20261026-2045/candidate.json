 "cards": [
  {
   "dot": "cyan",
   "title": "Cài đặt",
   "items": [
    "Managed install: scope khai trong shopify.app.toml, không có OAuth callback riêng",
    "afterAuth: tạo hoặc kích hoạt lại Shop, ghi app metafield (publicKey, apiUrl), webPixelCreate, xếp full sync",
    "Home đọc shopify.app.extensions() để biết app embed và block đã bật chưa (yêu cầu Built for Shopify)"
   ]
  },
  {
   "dot": "emerald",
   "title": "Lưu cấu hình",
   "items": [
    "Trọng số, bật/tắt trường, sort, filter: áp ngay khi query, không re-index",
    "Thêm/bớt metafield hoặc bật AI search làm đổi schema → xếp full sync",
    "Áp cấu hình: đẩy synonym/override sang Typesense, purge cache Redis, search-api (/internal/purge) và CDN"
   ]
  },
  {
   "dot": "amber",
   "title": "Trang khác",
   "items": [
    "Sync: Sync now (full sync từ Shopify) hoặc Reindex (dựng lại từ dữ liệu sẵn có)",
    "Sorting: bật best-selling theo order thì gọi shopify.scopes.request(['read_orders'])",
    "Plans: Shopify managed pricing; đổi gói cập nhật shop.plan"
   ]
  }
 ]
