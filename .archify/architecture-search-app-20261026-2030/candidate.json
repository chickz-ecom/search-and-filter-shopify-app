  "cards": [
    { "dot": "cyan", "title": "Luồng tìm kiếm (storefront)", "items": [
      "App embed nạp searchapp-sdk.js từ Shopify CDN; block search-results / collection-filter in sẵn grid Liquid native làm fallback",
      "Mặc định gọi qua App Proxy (same-origin); route /proxy chạy Search API ngay trong process Admin app. Chế độ CDN gọi thẳng service search-api",
      "Giá hiển thị: 1 request Storefront API nodes(ids) @inContext(country, language) cho cả trang",
      "Web pixel ghi add_to_cart / purchase sau lượt search → /v1/events (ẩn danh)"
    ] },
    { "dot": "emerald", "title": "Đồng bộ dữ liệu", "items": [
      "Full sync: nhiều bulk phẳng song song (groupObjects:false) → collection mới → swap alias",
      "Webhook / Events: chỉ xác thực + dedupe + enqueue; worker lấy bản mới nhất bằng nodes(ids)",
      "Cron worker: tick-delta mỗi 60s, checksum + best-selling + refresh markets lúc 03:00 UTC, rollup analytics mỗi 10 phút",
      "Best-selling: order 60 ngày (read_orders, tuỳ chọn) hoặc Storefront BEST_SELLING"
    ] },
    { "dot": "violet", "title": "Admin & merchandising", "items": [
      "Polaris web components + App Bridge; xác thực bằng ID token, expiring offline token",
      "Lưu synonym / rule / cấu hình → đẩy thẳng sang Typesense và purge cache Search API",
      "Worker cũng ghi PostgreSQL (SyncJob, OrderLine, AnalyticsDaily)"
    ] }
