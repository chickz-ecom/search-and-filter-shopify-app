# Copy to .env (dev) — giá trị giả, KHÔNG commit secret thật.
SHOPIFY_API_KEY=00000000000000000000000000000000
SHOPIFY_API_SECRET=shpss_fake_secret_for_local_dev
SCOPES=read_products,read_inventory,read_product_listings,read_publications,read_translations,read_locales,read_markets,unauthenticated_read_product_listings,write_app_proxy,write_pixels,read_customer_events
SHOPIFY_APP_URL=http://localhost:3000

# Postgres (dev dùng container postgres_db sẵn có; DB riêng search_app)
DATABASE_URL=postgresql://admin:password@localhost:5432/search_app?schema=public
# Redis (dev dùng docker-redis-1; DB index 5, prefix sa:)
REDIS_URL=redis://127.0.0.1:6379/5
REDIS_PREFIX=sa

# Typesense
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=dev-typesense-key
# Key chỉ có quyền search, dùng để sinh scoped key theo shop (search-api)
TYPESENSE_SEARCH_ONLY_KEY=

# Search API (services/search-api)
SEARCH_API_PORT=8787
SEARCH_API_PUBLIC_URL=http://localhost:8787
# Secret nội bộ để admin purge cache config trên search-api
INTERNAL_API_SECRET=dev-internal-secret
# Locale mặc định của search (en tối ưu trước, cấu hình được)
SEARCH_DEFAULT_LOCALE=en
# Trang tài liệu developer đã publish (docs/developers); trống = ẩn link ở trang Developers
DEVELOPER_DOCS_URL=

# CDN purge theo tag (tuỳ chọn; Cloudflare: https://api.cloudflare.com/client/v4/zones/<zone>/purge_cache)
CDN_PURGE_URL=
CDN_PURGE_TOKEN=
