{%- comment -%}
  Example section: custom product grid with "Load more", built on window.SearchApp.
  Add it to the search template (Online Store 2.0 / Horizon). Requires the app embed to be on.

  - Uses the merchant's relevance, filters, sort and market prices through sdk.search().
  - Reads q / filters / sort from the URL, so it works with any filter or sort UI that calls sdk.state.set().
  - The card markup is a <template> rendered by the SDK's safe template engine. It's wrapped in a Liquid
    raw tag so Liquid doesn't treat the double braces as Liquid output.
{%- endcomment -%}
<section class="ex-grid" id="ex-grid-{{ section.id }}" data-per-page="{{ section.settings.per_page }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="ex-grid__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <p class="ex-grid__count" aria-live="polite"></p>
  <ul class="ex-grid__list" style="--ex-cols: {{ section.settings.columns }}"></ul>
  <p class="ex-grid__empty" hidden>{{ section.settings.empty_text }}</p>
  <button type="button" class="ex-grid__more button" hidden>{{ section.settings.load_more }}</button>

  {% raw %}
  <template data-ex-card>
    <li class="ex-card">
      <a class="ex-card__link" href="{{url}}" data-sa-product="{{id}}" data-sa-pos="{{position}}">
        {{#if image}}<img src="{{image | img_url: 500}}" alt="{{image_alt}}" width="500" height="500" loading="lazy">{{/if}}
        <span class="ex-card__vendor">{{vendor}}</span>
        <span class="ex-card__title">{{title}}</span>
        <span class="ex-card__price">
          {{#if priceReady}}{{#if compare_at_price}}<s>{{compare_at_price}}</s> {{/if}}{{price}}{{else}}View price{{/if}}
        </span>
        {{#unless available}}<span class="ex-card__badge">Sold out</span>{{/unless}}
      </a>
    </li>
  </template>
  {% endraw %}
</section>

<style>
  #ex-grid-{{ section.id }} .ex-grid__list {
    display: grid;
    grid-template-columns: repeat(var(--ex-cols, 3), minmax(0, 1fr));
    gap: 24px;
    list-style: none;
    padding: 0;
  }
  @media (max-width: 749px) {
    #ex-grid-{{ section.id }} .ex-grid__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  #ex-grid-{{ section.id }} .ex-card__link { display: grid; gap: 4px; color: inherit; text-decoration: none; }
  #ex-grid-{{ section.id }} .ex-card__link img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; }
  #ex-grid-{{ section.id }} .ex-card__vendor { font-size: 0.85em; opacity: 0.7; }
  #ex-grid-{{ section.id }} .ex-grid__more:not([hidden]) { display: block; margin: 24px auto 0; }
</style>

<script>
  (function () {
    // Sections render before the app embed (which sits at the end of <body>), so wait for the DOM before
    // touching window.SearchApp. ready() loads the SDK on demand.
    function whenSearchApp(cb) {
      var go = function () { if (window.SearchApp) window.SearchApp.ready().then(cb); };
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', go, { once: true });
      else go();
    }
    var root = document.getElementById('ex-grid-{{ section.id }}');
    if (!root) return;

    whenSearchApp(function (sdk) {
      var list = root.querySelector('.ex-grid__list');
      var count = root.querySelector('.ex-grid__count');
      var empty = root.querySelector('.ex-grid__empty');
      var more = root.querySelector('.ex-grid__more');
      var card = root.querySelector('template[data-ex-card]').innerHTML;
      var perPage = Number(root.dataset.perPage) || 12;
      var page = 1;
      var lastQuery = '';

      function load(append) {
        var state = sdk.state.get();
        more.disabled = true;
        return sdk
          .search({ q: state.q, filters: state.filters, sort: state.sort, page: page, perPage: perPage })
          .then(function (res) {
            if (res.redirect) return window.location.assign(res.redirect);
            lastQuery = res.query;
            var html = res.products
              .map(function (p, i) {
                return sdk.render(card, Object.assign({}, p, { position: (page - 1) * perPage + i + 1 }));
              })
              .join('');
            if (append) list.insertAdjacentHTML('beforeend', html);
            else list.innerHTML = html;
            count.textContent = res.total + (res.total === 1 ? ' product' : ' products');
            empty.hidden = res.total > 0;
            more.hidden = page >= res.pages;
          })
          .catch(function () {
            more.hidden = true; // Keep whatever is on screen; the theme's native results stay usable.
          })
          .finally(function () {
            more.disabled = false;
          });
      }

      more.addEventListener('click', function () {
        page += 1;
        load(true);
      });

      // Another section (filters, sort dropdown) changed the URL state: start again from page 1.
      sdk.on('filters:change', function () { page = 1; load(false); });
      sdk.on('sort:change', function () { page = 1; load(false); });
      window.addEventListener('popstate', function () { page = 1; load(false); });

      // Click analytics (anonymous): which result was opened, at which position.
      list.addEventListener('click', function (e) {
        var a = e.target.closest('a[data-sa-product]');
        if (a) sdk.track('click', { productId: a.dataset.saProduct, position: Number(a.dataset.saPos), query: lastQuery });
      });

      load(false);
    });
  })();
</script>

{% schema %}
{
  "name": "Custom search grid",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Results" },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 4, "max": 48, "step": 4, "default": 12 },
    { "type": "text", "id": "load_more", "label": "Load more label", "default": "Load more" },
    { "type": "text", "id": "empty_text", "label": "No results text", "default": "No products found." }
  ],
  "presets": [{ "name": "Custom search grid" }]
}
{% endschema %}
